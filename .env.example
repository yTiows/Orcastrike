# Copy to .env (gitignored) for local tooling. Never commit real values.
# Cloudflare deploy credentials (wrangler reads these from the environment).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# CSFloat API key. Production: set as a Worker secret, never in wrangler.toml:
#   npx wrangler secret put CSFLOAT_API_KEY
# Local `wrangler dev`: put it in .dev.vars (gitignored), not here.
CSFLOAT_API_KEY=
